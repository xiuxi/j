	public static String get_space() {
		String space = "";
		for (int i = 0; i <
		// 15
				2; i++) {
			space += "   ";
		}
		// space = "";
		return space;
	}

	private static String reverse(String space_text) {
		space_text = space_text.replace("  ", " ");
		StringBuffer sb = new StringBuffer();
		if (false) {
			if (space_text.contains(" ")) {
				String[] split = space_text.split(" ");
				for (int i = split.length - 1; i >= 0; i--) {
					sb.append(split[i] + " ");
				}
				return sb.toString();
			} else {
				return space_text;
			}
		} else {
			for (int i = space_text.length() - 1; i >= 0; i--) {
				sb.append(space_text.charAt(i));
			}
			return sb.toString();
		}
	}

