    public static AtomicReference<Long> update_time = new AtomicReference<>();
    static AtomicReference<Long> tryCount = new AtomicReference<>();
    public static void main(String[] args) throws Exception {
        new Thread(new Runnable() {
            @Override
            public void run() {
                while (true) {
                    try {
                        Thread.sleep(2000);
                        long pass = System.currentTimeMillis() - update_time.get();
                        if (pass > 30 * 1000) {
                            if (wk != null) {
                                // System.out.println("reset");
                                wk.reset();
                            }
                        }
                        if (pass > 3 * 60 * 1000) {
                            
                            FileUtils.write(new File("C:\\mpc-hc\\srt_tmp\\time.txt"), ""+pass, "utf8");
                            if (tryCount.get() > 2) {
                                System.out.println(pass);
                                System1.exit(0);
                            }
                            tryCount.set(tryCount.get()+1);
                        }
                    } catch (Exception e) {
                    }
                }
            }
        }).start();
        main1(args);
        main2(args);
    }
