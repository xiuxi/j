    private static boolean auto_read_next() {
        try {
            return FileUtils
                    .readFileToString(new File(
                            "D:\\gitHub\\java_ubuntu_windows\\bat\\notepad++\\code.exe_read_next_line.txt"),
                            "utf8")
                    .equals("1");
        } catch (Exception e) {
            write.throw_(e);
        }
        return false;
    }

    public static void play() {
        try {
            CmdExcuter.executer(
                    class_dir.get_path(
                            "D:/gitHub/java_ubuntu_windows/autohotkey/mpc-hc.exe.play.exe"));
        } catch (Exception e) {
            write.throw_(e);
            e.printStackTrace();
        }
    }

    private static void speech(String all_text) {
        if (prev_text.equals(all_text)) {
            return;
        }
        cmd_cls.cls();
        prev_text = all_text;
        String text = "";
        for (String line : srt_list) {
            int index = line.indexOf("`");
            if (index > 0) {
                line = line.replace("`", "`\n");
            }
            text += line + "\n";
        }
        String[] lines = text.split("\n");
        String prev_text1 = "";
        String en_all = "";
        for (String line : lines) {
            line = line.trim();
            if (line.length() > 0) {
                if (line.equals(prev_text1)) {
                    continue;
                }
                prev_text1 = line;
                if (false) {
                    System.out.println(zh_feng_ci.printLine(ChineseUtils.toTraditional(line)));
                }
                if (!containsHanScript.containChinese(line)) {
                    en_all += line + " ";
                }
            }

        }
        en_all = en_all.trim();
        for (String line : lines) {
            line = line.trim();
            if (line.length() > 0) {
                if (line.equals(prev_text1)) {
                    continue;
                }
                prev_text1 = line;
                if (containsHanScript.containChinese(line)) {
                    if (true) {
                        speak2(line);
                    }
                }
            }
        }
    }

    private static void list_dirs(File file) {
        if (file.isDirectory()) {
            if (file.getName().charAt(0) == '.') {
                return;
            } else {
                if (!("D:\\gitHub\\java_ubuntu_windows").equals(file.toString())) {
                    dirs.add(file.toString());
                }
            }
            File[] sub_files = file.listFiles();
            for (File sub_file : sub_files) {
                list_dirs(sub_file);
            }
        }
    }
}