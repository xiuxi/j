                                                                                write.throw_(e2);
                                                                                e2.printStackTrace();
                                                                            } finally {
                                                                                is_reading_zh.set(false);

                                                                                code_exe_read_next_line_exe();
                                                                            }
                                                                        }

                                                                    }).start();
                                                                }
                                                            } else {
                                                                if (false) {
                                                                    System.out.println("a");
                                                                }
                                                            }
                                                            prev_atomic_text.set(text2);
                                                        } catch (Exception e) {
                                                            write.throw_(e);
                                                            e.printStackTrace();
                                                        }
                                                    }
                                                    boolean valid = wk
                                                            .reset();
                                                    continue;
                                                }
                                                if (false) {
                                                    System.out.println(pin_yin_chinese2pinyin2.to_pin_yin(text2));
                                                    System.out.println(
                                                            zh_feng_ci.printLine(ChineseUtils.toTraditional(text2)));
                                                }
                                                prev_text = text2;
                                            }

                                        }
                                        // code_center();
                                        boolean valid = wk
                                                .reset();
                                        continue;
                                    }
                                }
                                if (false) {
                                    play();
                                } else {
                                    CmdExcuter.executer(class_dir
                                            .get_path("D:/gitHub/java_ubuntu_windows/autohotkey/mpc-hc.exe.pause.exe"));
                                }
                                File file1 = new File(dir1, changed.toString());
                                List<String> lines = FileUtils.readLines(file1, "gbk");
                                srt_list.clear();
                                if (lines.size() >= 2) {
                                    String srt_path = lines.get(0);

                                    if (srt_path.trim().length() == 0) {
                                        String all_text = lines.get(2);
                                        srt_list.add(all_text);
                                        speech(all_text);

                                    } else {
                                        if (srt_path.endsWith(".txt")) {
                                            srt_path = srt_path.substring(0, srt_path.length() - ".txt".length());
                                        }
                                        List<String> srt_lines_ = srt_lines_map.get(srt_path);
                                        if (srt_lines_ == null) {
                                            List<String> srt_lines___ = new ArrayList<>();
                                            List<String> srt_lines__ = FileUtils.readLines(new File(srt_path), "utf8");
                                            for (int i = 0; i < srt_lines__.size(); i++) {
                                                String line = srt_lines__.get(i);
                                                if (srt.srt(line) && i + 1 < srt_lines__.size()) {
                                                    srt_lines___.add(srt_lines__.get(i + 1));
                                                }
                                            }
                                            srt_lines_map.put(srt_path, srt_lines___);
                                            srt_lines_ = srt_lines___;
                                            prev_text_index = 0;
                                        }
                                        if (srt_lines_ != null) {
                                            String all_text = "";
                                            int current_index = Integer.parseInt(lines.get(1));
                                            if (prev_text_index == 0) {
                                                prev_text_index = current_index;
                                            }
                                            String text = srt_lines_.get(current_index);
                                            if (current_index - prev_text_index > 1) {
                                                prev_text_index = current_index - 1;
                                            }
                                            if (prev_text_index < current_index) {
                                                for (int i = prev_text_index; i < current_index
                                                        && i < srt_lines_.size(); i++) {
                                                    String txt = srt_lines_.get(i);
                                                    srt_list.add(txt);
                                                    int index = txt.indexOf("`");
                                                    if (index > 0 && false) {
                                                        txt = txt.substring(0, index);
                                                    }
                                                    all_text += txt + "\n";
                                                }
                                            }
                                            srt_list.add(text);
                                            int index = text.indexOf("`");
                                            if (index > 0 && false) {
                                                text = text.substring(0, index);
                                            }
                                            all_text += text;
                                            prev_text_index = current_index;
                                            prev_text_index += 1;
                                            // write.text("a1=" + all_text);
                                            if (false) {
                                                speech(all_text);
                                            } else {
                                                from_mp4 = true;
                                                speak2(all_text);
                                            }
                                        }
                                    }
                                }
                            } catch (Exception e) {
                                write.throw_(e);
                                e.printStackTrace();
                            }

                            play();
                            wk.reset();
                        }
                    }
                }
            } catch (Exception e) {
                write.throw_(e);
                wk.reset();
                System.out.println("error");
                e.printStackTrace();
            }
        }
    
