    public static void speak2(String text) {
        while (all_list.size() > 2) {
            all_list.remove(0);
        }

        if (history_read.contains(text)) {
            return;
        }
        if (text.length() > 3) {
            if (text.charAt(1) == ':') {
                return;
            }
        }
        // write.throw_(text);
        history_read.add(text);
        while (history_read.size() > 3) {
            history_read.remove(0);
        }
        while (history_read_parts.size() > 10) {
            history_read_parts.remove(0);
        }
        // write.throw_(text);
        text = text.trim();
        if (text.equals("c window s system32 cmd exe")) {
            return;
        }
        // write.text(text);
        if (text.startsWith("o ")) {
            text = text.substring(2);
        }
        if (text.startsWith("//@o ")) {
            text = text.substring("//@o ".length());
        }
        {
            int index = text.indexOf("//@");
            if (index > 0) {
                String[] parts = text.split("//@");
                if (parts.length == 2) {
                    String part1 = parts[0];
                    String part2 = parts[1];
                    if (containsHanScript.containChinese(part2) && !containsHanScript.containChinese(part1)) {
                        text = part2 + "//@" + part1;
                    }
                }
            }
        }
        text = text.replaceAll("\\.+", ".");
        text = text.toLowerCase();
        text = text.replace("c++", " ");
        text = text.replace(".done", "");
        text = text.replace('@', ' ');
        text = replace.one_space(text);
        String[] lines = text.split("//", -1);
        String new_str = "";
        for (String zh__ : lines) {
            //write.text("__" + zh__);
            if (containsHanScript
                    .containChinese(zh__)) {
                
                zh__ = zh__.trim();
                String zh3 = replace.remove_number(zh__).replace('.', ' ').trim();
                if (zh3.equals("选项")
                        || zh3.equals("示例")
                        || zh3.equals("例子")) {
                    continue;
                }
                //write.text(zh3);
                if (zh__.length() > 0) {
                    if (true) {
                        String ens = "";
                        String zhs = "";
                        for (int i = 0; i < zh__.length(); i++) {
                            char ch = zh__.charAt(i);
                            String c = "" + ch;
                            String en_ = c.replaceAll("[^A-Za-z]", " ");
                            if (containsHanScript.containChinese(c)) {
                                zhs += c;
                            } else {
                                zhs += " ";
                            }
                            ens += en_;
                        }
                        String zh = "";
                        String en = "";
                        boolean en_contains = false;

                        int zh_start = 0;
                        for (int i = 0; i < ens.length(); i++) {

                            if (ens.charAt(i) == ' ' && zhs.charAt(i) == ' ') {
                                en += " ";
                                continue;
                            }
                            if (ens.charAt(i) != ' ') { // 包含英文
                                en += "" + ens.charAt(i);
                                zh_start = i;
                                if (zh.length() > 0) {
                                    //write.throw_(zh);
                                    // new_str += "z:"+zh+"\n";
                                    if (!all_list.contains(zh)) {
                                        new_str += "z:"+zh+"\n";
                                    }
                                    all_list.add(zh);
                                    if (false)
                                    java_cpp.speech1zh(
                                            zh.getBytes(),
                                            java_cpp.chinese,
                                            4, 100);
                                    // System.out.println(zh);
                                }

                                zh = "";
                            } else {
                                zh += "" + zhs.charAt(i);
                                if (en.length() > 0) {
                                    // System.out.println(en);
                                    //write.throw_(en);
                                    // new_str += "e:"+en+"\n";
                                    if (!all_list.contains(en)) {
                                        new_str += "e:"+en+"\n";
                                    }
                                    all_list.add(en);
                                    if (false)
                                    java_cpp.speech1zh(
                                            en.getBytes(),
                                            java_cpp.english,
                                            4, 100);
                                }
                                en = "";
                            }
                        }
                        if (en.trim().length() > 0) {
                            //write.throw_(en);
                            // new_str += "e:"+en+"\n";
                            if (!all_list.contains(en)) {
                                new_str += "e:"+en+"\n";
                            }
                            all_list.add(en);
                            if (false)
                            java_cpp.speech1zh(
                                    en.getBytes(),
                                    java_cpp.english,
                                    4, 100);
                        }
                        if (zh.trim().length() > 0) {
                            //write.throw_(zh);
                            // new_str += "z:"+zh+"\n";
                            if (!all_list.contains(zh)) {
                                new_str += "z:"+zh+"\n";
                            }
                            all_list.add(zh);
                            if (false)
                            java_cpp.speech1zh(
                                    zh.getBytes(),
                                    java_cpp.chinese,
                                    4, 100);
                        }
                    } else {
                        String zh2 = zh__;
                        zh__ = replace.remove_number(zh__);
                        //write.throw_(zh__);
                        // new_str += "z:"+zh__+"\n";
                        if (!all_list.contains(zh__)) {
                            new_str += "z:"+zh__+"\n";
                        }
                        all_list.add(zh__);
                        if (false)
                        java_cpp.speech1zh(
                                zh__.getBytes(),
                                java_cpp.chinese,
                                4, 100);
                        String en = zh2.replaceAll("[^A-Za-z]", " ");
                        //write.throw_(en);
                        // new_str += "e:"+en+"\n";
                        if (!all_list.contains(en)) {
                            new_str += "e:"+en+"\n";
                        }
                        all_list.add(en);
                        if (false)
                        java_cpp.speech1zh(
                                en.getBytes(),
                                java_cpp.english,
                                4, 100);
                    }
                }
                
            } else {
                zh__ = replace.remove_number(zh__);
                zh__ = zh__.trim();
                if ("options".equals(zh__)
                        || zh__.equals("examples")
                        || zh__.equals("example")) {
                    continue;
                }
                if (zh__.trim().length() > 0) {
                    //write.throw_(zh__);
                    // new_str += "e:"+zh__+"\n";
                    if (!all_list.contains(zh__)) {
                        new_str += "e:"+zh__+"\n";
                    }
                    all_list.add(zh__);
                    if(false)
                    java_cpp.speech1zh(
                            zh__.getBytes(),
                            java_cpp.english,
                            4, 100);
                }
            }
        }
        if (new_str.length() > 0) {
            if (from_mp4) {
                new_str = new_str.replaceAll("[0-9A-Za-z_\\\\*]", " ");
                new_str = new_str.replace('\n', ' ');
                new_str = new_str.trim();
                if (new_str.length() <= 0) {
                    return;
                }
                new_str = "z:"+new_str;
                new_str = new_str.trim();
            }
            java_cpp.speech1zhen(
                        new_str.getBytes(),
                        java_cpp.chinese,
                        4, 100);
        }
    }
