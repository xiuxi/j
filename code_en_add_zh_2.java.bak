                    } catch (IOException e) {
                        e.printStackTrace();
                    }
                }
            }
        }
    }

    private static void save(File file, List<String> lines) {
        StringBuffer sb = new StringBuffer();
        for (String line : lines) {
            sb.append(line + "\n");
        }
        try {
            FileUtils.write(file, sb.toString(), "utf8");
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

}
