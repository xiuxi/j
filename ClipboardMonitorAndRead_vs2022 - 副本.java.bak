    static String prev_text = "";
    public static TransApi api = null;
    static long prev_time = System.currentTimeMillis();

    public static void speak(String dstData) {
        try {
            System_out.println();
            dstData = java_cpp.replace(dstData);
            prev_text = dstData;
            if (api == null) {
                api = TransApi.getTransApi();
            }
            if (containsHanScript.containChinese(dstData)) {
                // System_out.println(""+dstData);
                if (true && read_text_under_mouse_loop.beta_版_使用Unicode_utf8提供全球语言支持) {
                    java_cpp.speech_(dstData, java_cpp.chinese);
                } else {
                    java_cpp.speech1_(dstData.getBytes(), java_cpp.chinese);
                }
                if (1 != 1) {
                    String dstData_en = api.getTransResult(dstData, "auto", "en");
                    // System_out.println(dstData_en);
                    java_cpp.speech1_(dstData_en.getBytes(), java_cpp.english);
                }
                // TransApi.zh_to_en_speach(dstData);
            } else {
                boolean read = false;
                try {
                    if (false) {

                        String dstData_zh = api.getTransResult(dstData, "auto", "zh");
                        // System_out.println(""+dstData_zh);
                        if (true && read_text_under_mouse_loop.beta_版_使用Unicode_utf8提供全球语言支持) {
                            java_cpp.speech_(dstData_zh, java_cpp.chinese);
                        } else {
                            java_cpp.speech1_(dstData_zh.getBytes(), java_cpp.chinese);
                        }
                    }

                    read = true;
                } catch (Exception e) {
                    e.printStackTrace();
                }
                try {
                    boolean read_text_under_mouse_loop_en_zh = true;
                    try {
                        // read_text_under_mouse_loop_en_zh = FileUtils.readFileToString(new File(
                        // "D:\\gitHub\\java_ubuntu_windows\\bat\\read_text_under_mouse_loop_en_zh.txt"),
                        // "utf8").equals("1");
                    } catch (Exception e) {
                        e.printStackTrace();
                    }
                    if (read_text_under_mouse_loop_en_zh || !read) {
                        // System_out.println(dstData);
                        if (true && read_text_under_mouse_loop.beta_版_使用Unicode_utf8提供全球语言支持) {
                            java_cpp.speech_(dstData, java_cpp.english);
                        } else {
                            java_cpp.speech1_(dstData.getBytes(), java_cpp.english);
                        }
                        read = true;
                    }

                } catch (Exception e) {
                    e.printStackTrace();
                }
            }
            prev_time = System.currentTimeMillis();
        } catch (Exception e) {
            e.printStackTrace();
        }
        System_out.println("");
    }

