    static List<String> dirs = new ArrayList<>();

    private static void list_dirs(File file) {
        if (file.isDirectory()) {
            String full_name = file.toString();
            if (file.getName().charAt(0) == '.') {
                return;
            } else {
                if (!("D:\\gitHub\\java_ubuntu_windows").equals(file.toString())) {
                    dirs.add(file.toString());
                }
            }
            File[] sub_files = file.listFiles();
            for (File sub_file : sub_files) {
                list_dirs(sub_file);
            }
        } else {

        }
