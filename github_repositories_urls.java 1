//https://stackoverflow.com/questions/19576742/how-to-clone-all-repos-at-once-from-github
public class github_repositories_urls {
    public static void main(String[] args) throws IOException {
        System.out.println("java j.git_dirs_rm");
        StringBuffer sb = new StringBuffer();
        sb.append("call gbk.bat\r\n");
        sb.append("rem java j.git_dirs_rm\r\n");
        File[] files = Dir.dir.listFiles();
        for (File file : files) {
            String name = file.getName();
            if (name.endsWith(".html")) {
                List<String> lines = FileUtils.readLines(file, "utf8");
                for (int i = 0; i < lines.size(); i++) {
                    String line = lines.get(i);
                    String text = "<a href=\"/xiaolongyuan/";
                    int index = line.indexOf(text);
                    if (index >= 0) {
                        index = index + "<a href=\"".length();
                        if (index >= 0) {
                            String url = line.substring(index);
                            index = url.indexOf("\"");
                            if (index > 0) {
                                url = "https://github.com" + url.substring(0, index);
                                sb.append("git clone " + url + "\r\n");
                                System.out.println("git clone " + url);
                            }
                        }
                    }
                }
            }
        }
        FileUtils.write(new File("download.bat"), sb.toString(), "gbk");
    }

