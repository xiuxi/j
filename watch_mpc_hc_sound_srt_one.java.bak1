public class watch_mpc_hc_sound_srt_one {
    static boolean pause = false;
    static List<String> srt_list = new ArrayList<>();
    static int read_zh_en = 1;
    static List<String> dirs = new ArrayList<>();
    static String prev_text = "";
    static AtomicBoolean is_reading_en = new AtomicBoolean(false);
    static AtomicBoolean is_reading_zh = new AtomicBoolean(false);
    static List<String> history_read = new ArrayList<>();
    static List<String> history_read_parts = new ArrayList<>();
    static boolean from_mp4 = false;
    static List<String> all_list = new ArrayList<>();

    static AtomicBoolean has_read_english = new AtomicBoolean();
    static String text2 = "";
    static  WatchKey wk = null;
    public static AtomicReference<Long> update_time = new AtomicReference<>();
    static AtomicReference<Long> tryCount = new AtomicReference<>();
    static ExecutorService executorService = new ThreadPoolExecutor(1, 1, 0L, TimeUnit.MILLISECONDS, new LinkedBlockingQueue<Runnable>());
    public static void speak(String text) {
        while (all_list.size() > 2) { all_list.remove(0); }

        if (history_read.contains(text)) { return; }
        if (text.length() > 3) {
            if (text.charAt(1) == ':') {
                return;
            }
        }
        history_read.add(text);
        while (history_read.size() > 3) {
            history_read.remove(0);
        }
        while (history_read_parts.size() > 10) {
            history_read_parts.remove(0);
        }
        text = text.trim();
        if (text.equals("c window s system32 cmd exe")) {
            return;
        }
        if (text.startsWith("o ")) {
            text = text.substring(2);
        }
        if (text.startsWith("//@o ")) {
            text = text.substring("//@o ".length());
        }
        int index = text.indexOf("//@");
        if (index > 0) {
            String[] parts = text.split("//@");
            if (parts.length == 2) {
                String part1 = parts[0];
                String part2 = parts[1];
                if (containsHanScript.containChinese(part2) && !containsHanScript.containChinese(part1)) {
                    text = part2 + "//@" + part1;
                }
            }
        }
        text = text.replaceAll("\\.+", ".");
        text = text.toLowerCase();
        text = text.replace("c++", " ");
        text = text.replace(".done", "");
        text = text.replace('@', ' ');
        text = replace.one_space(text);
        String[] lines = text.split("//", -1);
        String new_str = "";
        for (String zh__ : lines) {
            if (containsHanScript
                    .containChinese(zh__)) {
                
                zh__ = zh__.trim();
                String zh3 = replace.remove_number(zh__).replace('.', ' ').trim();
                if (zh3.equals("选项")
                        || zh3.equals("示例")
                        || zh3.equals("例子")) {
                    continue;
                }
                if (zh__.length() > 0) {
                    if (true) {
                        String ens = "";
                        String zhs = "";
                        for (int i = 0; i < zh__.length(); i++) {
                            char ch = zh__.charAt(i);
                            String c = "" + ch;
                            String en_ = c.replaceAll("[^A-Za-z]", " ");
                            if (containsHanScript.containChinese(c)) {
                                zhs += c;
                            } else {
                                zhs += " ";
                            }
                            ens += en_;
                        }
                        String zh = "";
                        String en = "";
                        boolean en_contains = false;
                        int zh_start = 0;
                        for (int i = 0; i < ens.length(); i++) {
                            if (ens.charAt(i) == ' ' && zhs.charAt(i) == ' ') {
                                en += " ";
                                continue;
                            }
                            if (ens.charAt(i) != ' ') { // 包含英文
                                en += "" + ens.charAt(i);
                                zh_start = i;
                                if (zh.length() > 0) {
                                    if (!all_list.contains(zh)) {
                                        new_str += "z:"+zh+"\n";
                                    }
                                    all_list.add(zh);
                                }
                                zh = "";
                            } else {
                                zh += "" + zhs.charAt(i);
                                if (en.length() > 0) {
                                    if (!all_list.contains(en)) {
                                        new_str += "e:"+en+"\n";
                                    }
                                    all_list.add(en);
                                }
                                en = "";
                            }
                        }
                        if (en.trim().length() > 0) {
                            if (!all_list.contains(en)) {
                                new_str += "e:"+en+"\n";
                            }
                            all_list.add(en);
                        }
                        if (zh.trim().length() > 0) {
                            if (!all_list.contains(zh)) {
                                new_str += "z:"+zh+"\n";
                            }
                            all_list.add(zh);
                        }
                    } else {
                        String zh2 = zh__;
                        zh__ = replace.remove_number(zh__);
                        if (!all_list.contains(zh__)) {
                            new_str += "z:"+zh__+"\n";
                        }
                        all_list.add(zh__);
                        String en = zh2.replaceAll("[^A-Za-z]", " ");
                        if (!all_list.contains(en)) {
                            new_str += "e:"+en+"\n";
                        }
                        all_list.add(en);
                    }
                }
            } else {
                zh__ = replace.remove_number(zh__);
                zh__ = zh__.trim();
                if ("options".equals(zh__) || zh__.equals("examples") || zh__.equals("example")) {
                    continue;
                }
                if (zh__.trim().length() > 0) {
                    if (!all_list.contains(zh__)) {
                        new_str += "e:"+zh__+"\n";
                    }
                    all_list.add(zh__);
                }
            }
        }
        if (new_str.length() > 0) {
            if (from_mp4) {
                new_str = new_str.replaceAll("[0-9A-Za-z_\\\\*]", " ");
                new_str = new_str.replace('\n', ' ');
                new_str = new_str.trim();
                if (new_str.length() <= 0) {
                    return;
                }
                new_str = "z:"+new_str;
                new_str = new_str.trim();
            }
            java_cpp.speech1zhen(new_str.getBytes(), java_cpp.chinese, 4, 100);
        }
    }
    
    public static void main(String[] args) throws Exception {
        update_time.set(System.currentTimeMillis());
        tryCount.set(new Long(0));
        executorService.execute(() ->{
            while (true) {
                try {
                    Thread.sleep(2000);
                    long pass = System.currentTimeMillis() - update_time.get();
                    if (pass > 30 * 1000) {
                        if (wk != null) {
                            wk.reset();
                        }
                    }
                    if (pass > 3 * 60 * 1000) {
                        FileUtils.write(new File("C:\\mpc-hc\\srt_tmp\\time.txt"), ""+pass, "utf8");
                        if (tryCount.get() > 2) {
                            System.out.println(pass);
                            System1.exit(0);
                        }
                        tryCount.set(tryCount.get()+1);
                    }
                } catch (Exception e) { }
            }
        });
        main1(args);
    }

    public static void main1(String[] args) throws Exception {
        String prev_text = "";
        while (true) {
            try {
                String dir1 = ("C:\\mpc-hc\\srt\\");
                final Path path = FileSystems.getDefault().getPath(dir1);
                int prev_text_index = 0;
                AtomicReference<String> atomic_text = new AtomicReference<>("");
                AtomicReference<String> atomic_text_prev = new AtomicReference<>("");
                AtomicReference<String> prev_atomic_text = new AtomicReference<>("");
                Map<String, List<String>> srt_lines_map = new HashMap<>();
                try (final WatchService watchService = FileSystems.getDefault().newWatchService()) {
                    path.register(watchService, StandardWatchEventKinds.ENTRY_MODIFY);
                    while (true) {
                        wk = watchService.take();
                        for (WatchEvent<?> event : wk.pollEvents()) {
                            try {
                                tryCount.set(new Long(0));
                                update_time.set(System.currentTimeMillis());
                                final Path changed = (Path) event.context();
                                from_mp4 = false;
                                String changed_file = changed.toString();
                                System.out.println("changed_file="+changed_file);
                                if (!changed_file.equals("srt_line.txt")) {
                                    if (changed_file.equals("clipboard.txt")) {
                                        File file1 = new File(dir1, changed.toString());
                                        text2 = FileUtils.readFileToString(file1, "utf8");
                                        if (!prev_text.equals(text2)) {
                                            cmd_cls.cls();
                                            System.out.println("\n\n---------"+text2);
                                            if (text2.endsWith("_@_")) {
                                                try {
                                                    System.out.println(text2);
                                                    atomic_text.set(text2);
                                                    if (!prev_atomic_text.get().equals(atomic_text.get())
                                                            && !containsHanScript.containChinese(text2)) {
                                                        if (!is_reading_en.get()) {
                                                            is_reading_en.set(true);
                                                            executorService.execute(() ->{
                                                                try {
                                                                    if (!is_reading_zh.get()) {
                                                                        String zh = text2;//GoogleTranslateUtil.to_zh(text);
                                                                        if (zh.length() - "_@_".length() >= 0) {
                                                                            zh = zh.substring(0, zh.length() - "_@_".length());
                                                                        }
                                                                        zh = zh.replace("_", " ");
                                                                        zh = zh.replace('*', ' ');
                                                                        if (read_english.True()) {
                                                                            speak(zh);
                                                                        }
                                                                    }
                                                                } catch (Exception e) {
                                                                    throw1_(e);
                                                                } finally {
                                                                    is_reading_en.set(false);
                                                                }
                                                            });
                                                        }
                                                        executorService.execute(() ->{
                                                            try {
                                                                String en = text2;
                                                                if (en.length() - "_@_".length() >= 0) {
                                                                    en = en.substring(0,
                                                                    en.length() - "_@_".length());
                                                                }
                                                                String zh = GoogleTranslateUtil.to_zh(en);
                                                                if (!is_reading_en.get() && !is_reading_zh
                                                                        .get()) {
                                                                    is_reading_zh.set(true);
                                                                    zh = zh.replace('*', ' ');
                                                                    speak(zh);
                                                                }
                                                            } catch (Exception e) {
                                                                throw1_(e);
                                                            } finally {
                                                                is_reading_zh.set(false);
                                                            }
                                                        });
                                                    }
                                                    prev_atomic_text.set(text2);
                                                } catch (Exception e) {
                                                    throw1_(e);
                                                }
                                                boolean valid = wk.reset();
                                                continue;
                                            } else if (text2.indexOf("_@2_") >= 0) {
                                                if (text2.length() > 0
                                                        && (text2.charAt(0) == '@'
                                                                || text2.replace("_@2_", "").indexOf('@') >= 0
                                                                || text2.endsWith("//@"))
                                                        || FileUtils.readFileToString(new File("D:\\gitHub\\java_ubuntu_windows\\bat\\notepad++\\code.exe_read_next_line.txt"),"utf8").equals("1")) {
                                                    try {
                                                        atomic_text.set(text2);
                                                        String zh = text2;
                                                        int index = zh.indexOf("_@2_");
                                                        if (index >= 0) {
                                                            zh = zh.substring(0, index);
                                                        }
                                                        speak(zh);
                                                    } finally {
                                                        is_reading_zh.set(false);
                                                        code_exe_read_next_line_exe();
                                                    }
                                                } else {
                                                    try {
                                                        atomic_text.set(text2);
                                                        if (!prev_atomic_text.get().equals(atomic_text.get())) {
                                                            if (!containsHanScript.containChinese(text2)) {
                                                                boolean is_empty_read = false;
                                                                int index4 = text2.indexOf("_@2_");
                                                                String en = text2;
                                                                if (index4>=0) {
                                                                    text2.substring(0, index4);
                                                                }
                                                                en = replace.remove_number(en);
                                                                en = en.trim();
                                                                if (en.equals("\r\n") || en.trim().length() < 3 ) {
                                                                    code_exe_read_next_line_exe();
                                                                    is_empty_read = true;
                                                                    atomic_text_prev.set(text2);
                                                                }
                                                                has_read_english.set(false);
                                                                if (!is_empty_read) {
                                                                    executorService.execute(() ->{
                                                                        try {
                                                                            if (text2.indexOf(
                                                                                    "code-runner.executorMapByGlob") >= 0) {
                                                                                return;
                                                                            }
                                                                            if (text2.equals(atomic_text_prev.get())) {
                                                                                atomic_text_prev.set(text2);
                                                                                return;
                                                                            }
                                                                            atomic_text_prev.set(text2);
                                                                            text2 = text2.replace("xxx", "");
                                                                            int index4_ = text2.indexOf("_@2_");
                                                                            String en_ = text2;
                                                                            if (index4_ >=0) {
                                                                                en_ = en_.substring(0, index4_);
                                                                            }
                                                                            String str1 = en_;
                                                                            en_ = replace.replace_en(en_);
                                                                            en_ = en_.replace("\r\n", "\n");
                                                                            if (en_.endsWith("\n")) {
                                                                                en_ = en_.substring(0,
                                                                                        en_.length() - 1);
                                                                            }
                                                                            if (en_.trim().length() > 0) {
                                                                                en_ = en_.replace("_", " ");
                                                                                en_ = upper_add_space.addSpace(en_);
                                                                                String zh = GoogleTranslateUtil.to_zh(en_);
                                                                                if (!is_reading_en.get() && !is_reading_zh.get()) {
                                                                                    is_reading_zh.set(true);
                                                                                    zh = zh.replace('*', ' ');
                                                                                    if (zh.indexOf("code-runner.executorMapByGlob") > 0) {
                                                                                        return;
                                                                                    }
                                                                                    if (!has_read_english.get()) {
                                                                                        if (read_english.True()) {
                                                                                            speak(str1);
                                                                                        }
                                                                                        has_read_english.set(true);
                                                                                    }
                                                                                    speak(zh);
                                                                                }
                                                                            }
                                                                        } catch (Exception e) {
                                                                            throw1_(e);
                                                                        } finally {
                                                                            is_reading_zh.set(false);
                                                                            code_exe_read_next_line_exe();
                                                                        }
                                                                    });
                                                                    executorService.execute(() ->{
                                                                        try {
                                                                            if (text2.indexOf("code-runner.executorMapByGlob") >= 0) {
                                                                                return;
                                                                            }
                                                                            if (!is_reading_en.get()
                                                                                    && !is_reading_zh
                                                                                            .get()) {
                                                                                is_reading_en.set(true);
                                                                                text2 = text2.replace("xxx","");
                                                                                String zh = text2;//GoogleTranslateUtil.to_zh(text);
                                                                                int index4_ = text2.indexOf("_@2_");
                                                                                if (index4_ > 0) {
                                                                                    zh = zh.substring(0, index4_);
                                                                                }
                                                                                zh = replace.replace_en(zh);
                                                                                zh = zh.replace("_", " ");
                                                                                zh = zh.replace('*', ' ');
                                                                                if (zh.indexOf("code-runner.executorMapByGlob") > 0) {
                                                                                    return;
                                                                                }
                                                                                if (!has_read_english.get()) {
                                                                                    has_read_english.set(true);
                                                                                    if (read_english.True()) {
                                                                                        speak(zh);
                                                                                    }
                                                                                }
                                                                            }
                                                                        } catch (Exception e) {
                                                                            throw1_(e);
                                                                        } finally {
                                                                            is_reading_en.set(false);
                                                                        }
                                                                    });
                                                                }
                                                            } else {
                                                                if (text2.startsWith("空空行")) {
                                                                    text2 = text2.substring("空空行".length());
                                                                }
                                                                executorService.execute(() ->{
                                                                    try {
                                                                        if (text2.indexOf("code-runner.executorMapByGlob") >= 0) {
                                                                            return;
                                                                        }
                                                                        String zh = text2;
                                                                        int index4_ = text2.indexOf("_@2_");
                                                                        if (index4_ >= 0) {
                                                                            zh = zh.substring(0, index4_);
                                                                        }
                                                                        if (zh.indexOf("code-runner.executorMapByGlob") > 0) {
                                                                            return;
                                                                        }
                                                                        int zh_en_index = zh.indexOf("`");
                                                                        if (zh_en_index > 0) {
                                                                            String en = zh.substring(zh_en_index);
                                                                            zh = zh.substring(0, zh_en_index);
                                                                            speak(zh);
                                                                            zh = en;
                                                                            speak(zh);
                                                                        } else {
                                                                            speak(zh);
                                                                        }
                                                                    } catch (Exception e2) {
                                                                        throw1_(e2);
                                                                    } finally {
                                                                        is_reading_zh.set(false);
                                                                        code_exe_read_next_line_exe();
                                                                    }
                                                                });
                                                            }
                                                        }
                                                        prev_atomic_text.set(text2);
                                                    } catch (Exception e) {
                                                        throw1_(e);
                                                    }
                                                }
                                                boolean valid = wk.reset();
                                                continue;
                                            }
                                            prev_text = text2;
                                        }
                                    }
                                    boolean valid = wk.reset();
                                    continue;
                                }
                                CmdExcuter.executer(class_dir.get_path("D:/gitHub/java_ubuntu_windows/autohotkey/mpc-hc.exe.pause.exe"));
                                File file1 = new File(dir1, changed.toString());
                                List<String> lines = FileUtils.readLines(file1, "gbk");
                                srt_list.clear();
                                if (lines.size() >= 2) {
                                    String srt_path = lines.get(0);
                                    if (srt_path.trim().length() == 0) {
                                        String all_text = lines.get(2);
                                        srt_list.add(all_text);
                                        speak(all_text);
                                    } else {
                                        if (srt_path.endsWith(".txt")) {
                                            srt_path = srt_path.substring(0, srt_path.length() - ".txt".length());
                                        }
                                        List<String> srt_lines_ = srt_lines_map.get(srt_path);
                                        if (srt_lines_ == null) {
                                            List<String> srt_lines___ = new ArrayList<>();
                                            List<String> srt_lines__ = FileUtils.readLines(new File(srt_path), "utf8");
                                            for (int i = 0; i < srt_lines__.size(); i++) {
                                                String line = srt_lines__.get(i);
                                                if (srt.srt(line) && i + 1 < srt_lines__.size()) {
                                                    srt_lines___.add(srt_lines__.get(i + 1));
                                                }
                                            }
                                            srt_lines_map.put(srt_path, srt_lines___);
                                            srt_lines_ = srt_lines___;
                                            prev_text_index = 0;
                                        }
                                        if (srt_lines_ != null) {
                                            String all_text = "";
                                            int current_index = Integer.parseInt(lines.get(1));
                                            if (prev_text_index == 0) {
                                                prev_text_index = current_index;
                                            }
                                            String text = srt_lines_.get(current_index);
                                            if (current_index - prev_text_index > 1) {
                                                prev_text_index = current_index - 1;
                                            }
                                            if (prev_text_index < current_index) {
                                                for (int i = prev_text_index; i < current_index && i < srt_lines_.size(); i++) {
                                                    String txt = srt_lines_.get(i);
                                                    srt_list.add(txt);
                                                    int index = txt.indexOf("`");
                                                    all_text += txt + "\n";
                                                }
                                            }
                                            srt_list.add(text);
                                            int index = text.indexOf("`");
                                            all_text += text;
                                            prev_text_index = current_index;
                                            prev_text_index += 1;
                                            from_mp4 = true;
                                            speak(all_text);
                                        }
                                    }
                                }
                            } catch (Exception e) { throw1_(e); }
                            CmdExcuter.executer(class_dir.get_path("D:/gitHub/java_ubuntu_windows/autohotkey/mpc-hc.exe.play.exe"));
                            wk.reset();
                        }
                    }
                }
            } catch (Exception e) { throw1_(e); }
        }
    }

    public static void throw1_(Exception e) {
        wk.reset();
        write.throw_(e);
        e.printStackTrace();
    }

    static void code_exe_read_next_line_exe() {
        CmdExcuter.executer(class_dir.get_path("D:/gitHub/java_ubuntu_windows/bat/notepad++/code.exe_read_next_line.exe"));
    }
}