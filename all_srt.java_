
package j;

import java.io.File;
import java.io.IOException;
import java.util.List;

import org.apache.commons.io.FileUtils;

public class all_srt {
    public static void main(String[] args) throws IOException {
        init.init(all_srt.class);
        //D:\vtt_srt_时间正确\new\ok>es g:\*\*.srt >g.txt
        //D:\all_srt\g2>es f:\*\*.srt >g.txt
        List<String> lines = FileUtils.readLines(new File(
                // "C:\\vtt_srt_时间正确\\new\\ok\\g.txt")//, "gbk"
                "C:\\all_srt\\g2\\g.txt")//, "gbk"
        );
        for (String line : lines) {
            try {
                // String newName = line.substring("G:\\".length());
                String newName = line.substring("F:\\".length());
                File newFile = new File(".", newName);
                if (!newFile.exists()) {

                    File source = new File(line);
                    if (source.exists())
                        FileUtils.copyFile(source, newFile);

                }
            } catch (Exception e) {
                e.printStackTrace();
            }
            //System.out.println(line);
        }
    }
}
