    static Map<String, String> replace_map = new HashMap<>();
    static {
        replace_map.put("哇哇", "哇");
        replace_map.put("嘎嘎", "嘎");
        replace_map.put("嗷嗷", "嗷");
        replace_map.put("啦啦", "啦");
    }

    private static String replace(String myString2) {
        for (String key : replace_map.keySet()) {
            while (myString2.contains(key)) {
                myString2 = myString2.replaceAll(key, replace_map.get(key));
            }
        }
        // myString2 = myString2.replaceAll("哇哇", "哇");
        // myString2 = myString2.replaceAll("嘎", " ");
        // myString2 = myString2.replaceAll("嗷", " ");
        // myString2 = myString2.replaceAll("啦", " ");
        return myString2;
    }

