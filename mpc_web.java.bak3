    private static String removeUrl(String commentstr) {
        String urlPattern = "((https?|ftp|gopher|telnet|file|Unsure|http):((//)|(\\\\))+[\\w\\d:#@%/;$()~_?\\+-=\\\\\\.&]*)";
        Pattern p = Pattern.compile(urlPattern, Pattern.CASE_INSENSITIVE);
        Matcher m = p.matcher(commentstr);
        int i = 0;
        while (m.find()) {
            commentstr = commentstr.replaceAll(m.group(i), "").trim();
            i++;
        }
        return commentstr;
    }

    private static String findSrtLine(File srtFile, String srtStart) throws IOException {
        if (true) {
            try {
                String s = FileUtils.readFileToString(new File(
                        class_dir.get_path("D:\\gitHub\\java_ubuntu_windows\\bat\\srt_标点解析.txt")), "utf8");
                if (s.equals("1")) {
                    return findSrtLine1(srtFile, srtStart);
                }
            } catch (Exception e) {
                // e.printStackTrace();
            }
        }
        srtStart = srtStart.replaceAll(":", "");
        int current = Integer.parseInt(srtStart);
        List<String> srtLines = srtLinesMap.get(srtFile);
        if (srtLines == null) {
            srtLines = FileUtils.readLines(srtFile, "utf8");//
            srtLinesMap.put(srtFile, srtLines);
        }
        for (int i = 0; i < srtLines.size(); i++) {
            String line = srtLines.get(i);
            // System.out.println(line);
            if (line.length() == "00:00:02,190 --> 00:00:07,590".length()
                    && line.contains(" --> ")) {
                int start = Integer.parseInt(line.split(" --> ")[0].substring(0, "00:02:16".length())
                        .replaceAll(":", ""));
                int end = Integer.parseInt(line.split(" --> ")[1].substring(0, "00:02:16".length())
                        .replaceAll(":", ""));
                if (current >= start && current < end) {
                    // System.out.println(srtStart + " " + line);
                    return srtLines.get(i + 1);
                }
            }
        }
        // System.out.println("findSrtLine 可能格式错误");
        return "";
    }

    static Map<File, List<String>> srtLinesMap = new HashMap<>();

    public static Map<String, Map> srt_lines = new HashMap<>();
    public static String english = "";

    public static String findSrtLine1(File srtFile, String srtStart) throws IOException {
        try {
            srtStart = srtStart.replaceAll(":", "");
            int current = Integer.parseInt(srtStart);
            if (srt_lines.get(srtFile.toString()) == null) {
                // D:\derek banas\c++tutorial derek\C++ Tutorial 9 - Lambda
                // Expressions-482weZjwVHY.zh_en.srt 00:10:54
                List<String> srtLines = FileUtils.readLines(srtFile, "utf8");
                String prev_text = "";
                String start_srt = "";
                Map<String, String> map = new HashMap<>();
                List<String> srts = new ArrayList<>();
                for (int i = 0; i < srtLines.size(); i++) {
                    String line = srtLines.get(i);
                    if (srt.srt(line)) {
                        int textLine = i + 1;
                        if (textLine < srtLines.size()) {
                            String srtLine = srtLines.get(textLine);
                            String zh_line = "";
                            if (srtLine.contains("`")) {
                                zh_line = srtLine.split("`")[0];

                                // String[] split2 = srtLine.split("`");
                                // if (split2.length == 2) {
                                // english = split2[1];
                                // }
                            } else {
                                zh_line = srtLine;
                            }
                            if ("".equals(start_srt)) {
                                start_srt = line;
                            }
                            if (zh_line.contains("，")) {
                                int split_index = zh_line.indexOf('，');
                                // System.out.println("zh_line="+zh_line);
                                prev_text += zh_line.substring(0, split_index);
                                map.put(start_srt, prev_text);
                                srts.add(start_srt);
                                start_srt = line;
                                prev_text = zh_line.substring(split_index + 1);
                            } else {
                                prev_text += zh_line;
                            }
                        }
                    }
                }
                // System.out.println("srtStart="+srtStart);
                for (String line : srts) {
                    int start = Integer.parseInt(line.split(" --> ")[0].substring(0, "00:02:16".length())
                            .replaceAll(":", ""));
                    int end = Integer.parseInt(line.split(" --> ")[1].substring(0, "00:02:16".length())
                            .replaceAll(":", ""));
                    if (current >= start && current < end) {
                        String currentLine = map.get(line);
                        return currentLine;
                    }
                }
            }
        } catch (Exception e) {
            // e.printStackTrace();
        }
        return "";
    }

    static Map<String, File> zh_en_map = new HashMap<>();

    public static File findSrtFile(String mp4FullName) {
        File srt_file = zh_en_map.get(mp4FullName);
        if (srt_file != null) {
            return srt_file;
        }
        String base = mp4FullName.substring(0, mp4FullName.lastIndexOf("."));
        File zh_en_srt = new File(base + ".zh_en.srt");
        if (zh_en_srt.exists()) {
            zh_en_map.put(mp4FullName, zh_en_srt);
            return srt_file;
        }
        String mp4Part = mp4FullName.substring(0, mp4FullName.length()
                - ".srt".length());
        File[] dirFiles = new File(mp4FullName).getParentFile().listFiles();
        for (File file : dirFiles) {
            String srtFullName = file.toString();
            if (file.isFile() && srtFullName.startsWith(mp4Part) &&
                    srtFullName.endsWith(".srt")) {
                // System.out.println(file.toString());
                return file;
            }
        }
        return null;
        // File mp4 = new File(mp4FullName);

        // return new File(mp4FullName.substring(0, mp4FullName.length() -
        // ".srt".length()) + ".web.txt");
    }

    public static String readStringFromURL(String requestURL) throws IOException {
        try (Scanner scanner = new Scanner(new URL(requestURL).openStream(),
                StandardCharsets.UTF_8.toString())) {
            scanner.useDelimiter("\\A");
            return scanner.hasNext() ? scanner.next() : "";
        }
    }

